# Copy to .env and edit:  cp .env.example .env
# Note: variables already exported in your shell override this file.

# --- Which machine is this? ---------------------------------------------------------------
# pc      -> pc-dev          (workstation: RViz2, MoveIt 2, Gazebo)
# jetson  -> jetson-driver   (the Nano in the arm's base)
COMPOSE_PROFILES=pc

# GPU override for the PC (pick at most one; leave commented for software rendering):
# COMPOSE_FILE=compose.yml:compose/nvidia.yml
# COMPOSE_FILE=compose.yml:compose/dri.yml

# --- Host user (must match the owner of ../ros2_ws so builds are writable) ----------------
# Set with:  sed -i "s/^USER_UID=.*/USER_UID=$(id -u)/; s/^USER_GID=.*/USER_GID=$(id -g)/" .env
USER_UID=1000
USER_GID=1000

# --- ROS 2 networking: IDENTICAL on the PC and the Jetson ----------------------------------
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET

# --- Image naming ---------------------------------------------------------------------------
IMAGE_PREFIX=braco
# Use e.g. lyrical-arm64 when cross-building the Jetson image on the PC.
IMAGE_TAG=lyrical

# --- Pins -----------------------------------------------------------------------------------
# ros2-apt-source version used to add the ROS apt repository. 1.3.0 is verified for Ubuntu 26.04;
# use `latest` to resolve it at build time (GitHub API first, redirect as fallback).
ROS_APT_SOURCE_VERSION=1.3.0
# pymycobot from PyPI; empty = latest.
PYMYCOBOT_VERSION=

# --- Jetson only ---------------------------------------------------------------------------
# Serial link to the arm's controller. On the Jetson Nano version this is normally the UART
# /dev/ttyTHS1 at 1000000 baud - verify against the Elephant Robotics docs for your unit.
MYCOBOT_PORT=/dev/ttyTHS1
MYCOBOT_BAUD=1000000
# Numeric GID of 'dialout' on the Jetson host:  getent group dialout | cut -d: -f3
DIALOUT_GID=20

# --- Jetson only: always-on arm services (make arm-up) ------------------------------------
# I2C bus of the LCD1602 used by the temperature_monitor node, and the joystick used by joystick_teleop.
LCD_I2C_BUS=/dev/i2c-0
JOYSTICK_DEVICE=/dev/input/js0
# Numeric GIDs of 'i2c' and 'input' on the Jetson host (make env fills them in):
#   getent group i2c | cut -d: -f3      getent group input | cut -d: -f3
I2C_GID=
INPUT_GID=

# --- PC only, with compose/dri.yml --------------------------------------------------
VIDEO_GID=44
RENDER_GID=992
