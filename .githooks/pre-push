#!/bin/sh
# pre-push: block the push if C++ or Python files are not formatted.
# Run manually: .githooks/pre-push

RED='\033[0;31m'
YELLOW='\033[1;33m'
RESET='\033[0m'

# Use the venv's tools (make setup) even when the venv is not activated.
PATH="$(git rev-parse --show-toplevel)/.venv/bin:$PATH"

for tool in clang-format ruff; do
    command -v "$tool" >/dev/null || { printf "${RED}ERROR:${RESET} '%s' not installed. Run: ${YELLOW}make setup${RESET}\n" "$tool"; exit 1; }
done

if ! make -s format-check; then
    printf "${RED}ERROR:${RESET} formatting errors found, push aborted.\n"
    printf "  Fix with: ${YELLOW}make format${RESET}\n"
    exit 1
fi
