#!/bin/sh
# pre-push: block the push if C++ or Python files are not formatted.
# Run manually: .githooks/pre-push

RED='\033[0;31m'
YELLOW='\033[1;33m'
RESET='\033[0m'

# Use the venv's tools (make setup) even when the venv is not activated.
PATH="$(git rev-parse --show-toplevel)/.venv/bin:$PATH"

for tool in clang-format ruff; do
    command -v "$tool" >/dev/null || { printf "%bERROR:%b '%s' not installed. Run: %bmake setup%b\n" "$RED" "$RESET" "$tool" "$YELLOW" "$RESET"; exit 1; }
done

if ! make -s format-check; then
    printf "%bERROR:%b formatting errors found, push aborted.\n" "$RED" "$RESET"
    printf "  Fix with: %bmake format%b\n" "$YELLOW" "$RESET"
    exit 1
fi
