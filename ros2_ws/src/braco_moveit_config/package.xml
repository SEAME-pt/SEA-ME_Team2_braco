<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>braco_moveit_config</name>
  <version>0.0.0</version>
  <description>MoveIt 2 configuration of the braco arm: SRDF, kinematics, joint limits, controllers</description>
  <maintainer email="danielximenes164@gmail.com">Daniel Ximenes</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The model (config/braco.urdf.xacro includes it) and its controllers.yaml -->
  <exec_depend>braco_description</exec_depend>
  <exec_depend>braco_simulation</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- move_group: planning (OMPL), IK (KDL), trajectory execution through ros2_control -->
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <!-- launch/demo.launch.py: mock hardware (mock_components is in hardware_interface), RViz -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- scripts/lab_bench_scene.py: the table tops into the planning scene -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>shape_msgs</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>xacro</test_depend>
  <!-- test/test_plan_execute.launch.py -->
  <test_depend>ament_index_python</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>moveit_msgs</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <!-- test/test_launch.py: builds the launch descriptions (braco_simulation for sim's include) -->
  <test_depend>braco_description</test_depend>
  <test_depend>braco_simulation</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>moveit_configs_utils</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
