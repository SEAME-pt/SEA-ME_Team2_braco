<?xml version="1.0"?>
<!--
  myCobot 280 (Jetson Nano) arm, as a xacro macro: base_link, link1..link6, joint1..joint6.

  Adapted from Elephant Robotics' mycobot_ros2 (mycobot_description/urdf/mycobot_280_jn,
  BSD-2-Clause, see ../meshes/LICENSE.elephantrobotics). What changed:
    * joints renamed to joint1..joint6: the names arm_driver publishes in /joint_states
      (the vendor names joint2_to_joint1 ... joint6output_to_joint6 would never match, and
      robot_state_publisher would silently ignore the states)
    * links renamed base_link, link1..link6 (the vendor names a link "joint1" like a joint)
    * the vendor file is not valid XML (a stray "1" in the joint 1 limit): fixed
    * limits in radians come from JOINT_LIMITS in libs/cpp/includes/mycobot.hpp (see the
      properties below); test/test_urdf.py keeps them in sync
    * inertials added, velocity/effort set (see the UNMEASURED markers)
  Joint origins and mesh offsets are the vendor's, unchanged. Whether the model's zero pose
  looks like the real arm's upright pose is checked on the real arm (docs/urdf-sim-to-real.md).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Position limits, degrees. Same numbers as JOINT_LIMITS in libs/cpp/includes/mycobot.hpp
       (the arm's firmware limits minus 1-2 deg): change them there first, test_urdf.py fails
       otherwise. -->
  <xacro:property name="limit_min" value="${[-166.0, -138.0, -149.0, -149.0, -153.0, -178.0]}"/>
  <xacro:property name="limit_max" value="${[166.0, 138.0, 149.0, 149.0, 158.0, 178.0]}"/>

  <!-- Joint velocity limits, rad/s, J1..J6: MEASURED on the real arm at speed 100
       (sim_to_real.py velocity, middle 80 % of a -A..+A sweep; docs/urdf-sim-to-real.md).
       joint3 measured 2.79 average but 2.72 peak (a 0.6 s sweep at 20 Hz joint states):
       the lower one is used. The firmware speed setting scales linearly: rad/s = 0.0265 x speed. -->
  <xacro:property name="joint_velocity" value="${[2.64, 2.44, 2.72, 2.69, 2.65, 2.60]}"/>

  <!-- Effort limits, N*m, J1..J6: APPROXIMATION. Elephant Robotics does not publish the joint
       servos' torque, so this is the lower bound the published spec implies: the static torque
       to hold the arm (masses below) plus the rated 0.25 kg payload at tcp in each joint's worst
       pose (J2 1.89, J3 1.15, J4 0.67, J5 0.57, with the camera plate), rounded up. J1 and J6 carry no gravity load and
       take their neighbour's value. Replace with stall torques if a datasheet turns up. -->
  <xacro:property name="joint_effort" value="${[1.9, 1.9, 1.2, 0.7, 0.6, 0.6]}"/>
  <!-- Masses, kg. ESTIMATED from documented totals (no scale yet, see docs/urdf-sim-to-real.md):
       whole arm 1.03 kg (myCobot 280 Jetson Nano spec sheet); moving links 1..6 about 0.65 kg
       (the standard 280 is 850 g with a ~0.2 kg M5 base), split by mesh volume
       (21 / 35 / 27 / 3 / 12 / 2 %); base_link (Jetson casing) the rest. -->
  <xacro:property name="base_mass" value="0.38"/>
  <xacro:property name="link_masses" value="${[0.14, 0.23, 0.17, 0.02, 0.08, 0.01]}"/>

  <!-- Solid cylinder around the link z axis, centred on the link frame. UNMEASURED: radius and
       length are rough; the point is a positive-definite inertia (Gazebo and MoveIt need one). -->
  <xacro:macro name="cylinder_inertial" params="mass radius length">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (3 * radius * radius + length * length) / 12}" ixy="0" ixz="0"
               iyy="${mass * (3 * radius * radius + length * length) / 12}" iyz="0"
               izz="${mass * radius * radius / 2}"/>
    </inertial>
  </xacro:macro>

  <!-- One link: the vendor mesh with the vendor's visual offset, also used for collision. -->
  <xacro:macro name="arm_link" params="name mesh mass xyz rpy">
    <link name="${name}">
      <visual>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry>
          <mesh filename="package://braco_description/meshes/arm/${mesh}.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry>
          <mesh filename="package://braco_description/meshes/arm/${mesh}.dae"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial mass="${mass}" radius="0.03" length="0.08"/>
    </link>
  </xacro:macro>

  <!-- Revolute joint number `n` (1..6), limited to JOINT_LIMITS. -->
  <xacro:macro name="arm_joint" params="n parent child xyz rpy">
    <joint name="joint${n}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="0 0 1"/>
      <limit lower="${radians(limit_min[n - 1])}" upper="${radians(limit_max[n - 1])}"
             velocity="${joint_velocity[n - 1]}" effort="${joint_effort[n - 1]}"/>
    </joint>
  </xacro:macro>

  <!-- flange_yaw (rad): turns the flange mesh about the joint 6 axis (see braco.urdf.xacro). -->
  <xacro:macro name="mycobot_280" params="parent:=world flange_yaw:=0 *origin">
    <xacro:arm_link name="base_link" mesh="base_link" mass="${base_mass}"
                    xyz="0 0 0" rpy="0 0 3.14159"/>
    <joint name="${parent}_to_base_link" type="fixed">
      <parent link="${parent}"/>
      <child link="base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <xacro:arm_link name="link1" mesh="link1" mass="${link_masses[0]}"
                    xyz="0 0 -0.06096" rpy="0 0 -1.5708"/>
    <xacro:arm_link name="link2" mesh="link2" mass="${link_masses[1]}"
                    xyz="0 0 0.03256" rpy="0 -1.5708 0"/>
    <xacro:arm_link name="link3" mesh="link3" mass="${link_masses[2]}"
                    xyz="0 0 0.03056" rpy="0 -1.5708 0"/>
    <xacro:arm_link name="link4" mesh="link4" mass="${link_masses[3]}"
                    xyz="0 0 -0.03356" rpy="0 -1.5708 1.5708"/>
    <xacro:arm_link name="link5" mesh="link5" mass="${link_masses[4]}"
                    xyz="0 0 -0.038" rpy="0 0 0"/>
    <xacro:arm_link name="link6" mesh="link6" mass="${link_masses[5]}"
                    xyz="0 0 -0.012" rpy="0 0 ${flange_yaw}"/>

    <xacro:arm_joint n="1" parent="base_link" child="link1"
                     xyz="0 0 0.15756" rpy="0 0 0"/>
    <xacro:arm_joint n="2" parent="link1" child="link2"
                     xyz="0 0 -0.001" rpy="0 1.5708 -1.5708"/>
    <xacro:arm_joint n="3" parent="link2" child="link3"
                     xyz="-0.1104 0 0" rpy="0 0 0"/>
    <xacro:arm_joint n="4" parent="link3" child="link4"
                     xyz="-0.096 0 0.06462" rpy="0 0 -1.5708"/>
    <xacro:arm_joint n="5" parent="link4" child="link5"
                     xyz="0 -0.07318 0" rpy="1.5708 -1.5708 0"/>
    <xacro:arm_joint n="6" parent="link5" child="link6"
                     xyz="0 0.0456 0" rpy="-1.5708 0 0"/>
  </xacro:macro>

</robot>
