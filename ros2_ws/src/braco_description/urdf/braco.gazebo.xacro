<?xml version="1.0"?>
<!--
  Gazebo (gz sim) additions to the braco model: a gz_ros2_control system with a position
  command interface on joint1..joint6, so the arm holds its pose instead of falling under
  gravity. Included by braco.urdf.xacro only with gazebo:=true; the real arm never sees it.

  With gripper:=true (gripper_actuated:=true) the gripper's master joint, gripper_controller, is
  position-controlled too (gripper_action_controller in config/controllers.yaml). Its five
  followers are listed with state interfaces only, so /joint_states reports them: the physics
  engine moves them from their <mimic> tags (worlds/lab_bench.sdf picks one that can).

  It also adds the wrist camera's sensor at camera_link (#123).

  Used by launch/gazebo.launch.py (and so by braco_bringup's sim:=true). The controllers on
  top (config/controllers.yaml) are the set planned for the real arm too: only this
  <hardware> plugin changes there (planned: a braco SystemInterface).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- One arm joint, position-controlled, starting at 0 (the zero pose). -->
  <xacro:macro name="gazebo_joint" params="n">
    <joint name="joint${n}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <!-- One mimic finger joint: no command, it follows gripper_controller -->
  <xacro:macro name="gazebo_finger" params="name">
    <joint name="${name}">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="braco_gazebo" params="controllers gripper:=false">
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <xacro:gazebo_joint n="1"/>
      <xacro:gazebo_joint n="2"/>
      <xacro:gazebo_joint n="3"/>
      <xacro:gazebo_joint n="4"/>
      <xacro:gazebo_joint n="5"/>
      <xacro:gazebo_joint n="6"/>
      <xacro:if value="${gripper}">
        <joint name="gripper_controller">
          <!-- The gripper controller commands a step (closed or open at once): the limiter
               would cut it to 1 rad/s and log an error every cycle. Gazebo's joint limits still
               apply. -->
          <limits enable="false"/>
          <command_interface name="position"/>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
        </joint>
        <xacro:gazebo_finger name="gripper_base_to_gripper_left2"/>
        <xacro:gazebo_finger name="gripper_left3_to_gripper_left1"/>
        <xacro:gazebo_finger name="gripper_base_to_gripper_right3"/>
        <xacro:gazebo_finger name="gripper_base_to_gripper_right2"/>
        <xacro:gazebo_finger name="gripper_right3_to_gripper_right1"/>
      </xacro:if>
    </ros2_control>

    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${controllers}</parameters>
      </plugin>
    </gazebo>

    <!-- The eye-in-hand camera at camera_link (x forward, as Gazebo's camera looks). Same size
         and rate as the real camera (braco_bringup/config/braco.yaml); the images carry
         camera_optical_frame, like the real ones. Gazebo publishes /camera/image_raw and
         /camera/camera_info; launch/gazebo.launch.py bridges them to ROS. Rendered by the
         world's Sensors system (worlds/lab_bench.sdf).
         UNMEASURED: the real lens's field of view; 60 deg horizontal until it is measured. -->
    <gazebo reference="camera_link">
      <sensor name="wrist_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/camera/image_raw</topic>
        <!-- gz-sensors' own tag for the header's frame_id (sdformat warns it is not SDF and
             keeps it; SDF's <optical_frame_id> does not reach the header) -->
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>${60 * pi / 180}</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.01</near>
            <far>5.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
