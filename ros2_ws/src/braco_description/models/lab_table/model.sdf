<?xml version="1.0"?>
<!--
  One white lab table, static. Frame on the floor, under the centre of the top.

  UNMEASURED (provisional): 1.60 m (y) x 0.80 m (x), top surface at 0.75 m, top 0.025 m thick. Change
  them together with the poses in worlds/lab_bench.sdf and robot_z in launch/gazebo.launch.py.
-->
<sdf version="1.9">
  <model name="lab_table">
    <static>true</static>
    <link name="link">
      <collision name="top_collision">
        <pose>0 0 0.7375 0 0 0</pose>
        <geometry>
          <box>
            <size>0.80 1.60 0.025</size>
          </box>
        </geometry>
      </collision>
      <visual name="top_visual">
        <pose>0 0 0.7375 0 0 0</pose>
        <geometry>
          <box>
            <size>0.80 1.60 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <visual name="leg_rear_left">
        <pose>-0.36 0.76 0.3625 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.725</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
        </material>
      </visual>
      <visual name="leg_rear_right">
        <pose>-0.36 -0.76 0.3625 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.725</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
        </material>
      </visual>
      <visual name="leg_front_left">
        <pose>0.36 0.76 0.3625 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.725</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
        </material>
      </visual>
      <visual name="leg_front_right">
        <pose>0.36 -0.76 0.3625 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.725</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
