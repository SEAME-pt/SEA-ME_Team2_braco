<?xml version="1.0"?>
<!--
  The lab bench of the real arm: two white tables joined along their long sides, a narrow gap
  between them.

  Gazebo's origin is on the floor, under the gap, at the tables' rear edge (their short sides):
    x  from the rear edge along the gap (the arm's work area)
    y  across the gap (the gap is at y = 0)
    z  up, the table top at 0.75 m

  The arm is not here: launch/gazebo.launch.py spawns it on the table (robot_x, robot_y, robot_z,
  robot_yaw). test_urdf.py keeps robot_z equal to the height of the table top.

  UNMEASURED: every size of the table and its place (models/lab_table/model.sdf) are provisional.
-->
<sdf version="1.9">
  <world name="lab_bench">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Bullet Featherstone, not the default DART: the gripper's five followers are <mimic>
         joints, and only this engine enforces them (DART: "does not support mimic constraints";
         gz_ros2_control's own mimic left a follower stuck at its limit). The arm behaves the
         same, ending within ~0.002 rad of a trajectory's end instead of 0.000 (#123). -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine><filename>gz-physics-bullet-featherstone-plugin</filename></engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.78 0.8 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 6 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.12 0.12 0.12 1</ambient>
            <diffuse>0.12 0.12 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The model's frame is on the floor under the table's centre, its 1.60 m side along its y:
         turned 90 deg, that side runs along x here. Rear edge at x = 0, so each centre is at x = 0.80;
         the 0.01 m gap at y = 0, so each centre is at y = +-(0.40 + 0.005). -->
    <include>
      <name>lab_table_left</name>
      <uri>model://lab_table</uri>
      <pose>0.80 0.405 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>lab_table_right</name>
      <uri>model://lab_table</uri>
      <pose>0.80 -0.405 0 0 0 1.5708</pose>
    </include>
  </world>
</sdf>
