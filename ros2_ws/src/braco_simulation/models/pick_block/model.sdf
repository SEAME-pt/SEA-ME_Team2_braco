<?xml version="1.0"?>
<!--
  The object of the pick-and-place demo (braco_mission, #148): a 20 x 20 x 40 mm block of 20 g,
  red, frame at its centre. Not in worlds/lab_bench.sdf: the demo spawns it at the pick pose.

  40 mm tall so the fingers squeeze its middle: grasped at tcp z = 0.025 m above the table. Lower,
  MoveIt stops the line down, as the open fingertips reach ~15 mm below the tcp and the table is in
  its planning scene; a 20 mm cube grasped that high slipped out on the way up.

  High friction, so the gripper holds it by squeezing alone (no attach plugin): mu on both
  engines' tags, Bullet Featherstone reads the ode ones.
-->
<sdf version="1.9">
  <model name="pick_block">
    <link name="link">
      <inertial>
        <mass>0.02</mass>
        <!-- solid box: m * (a^2 + b^2) / 12 -->
        <inertia>
          <ixx>3.333e-6</ixx><iyy>3.333e-6</iyy><izz>1.333e-6</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.02 0.02 0.04</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>2.0</mu>
              <mu2>2.0</mu2>
            </ode>
            <bullet>
              <friction>2.0</friction>
              <friction2>2.0</friction2>
            </bullet>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.02 0.02 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 1</ambient>
          <diffuse>0.9 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
