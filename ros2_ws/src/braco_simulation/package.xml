<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>braco_simulation</name>
  <version>0.0.0</version>
  <description>Gazebo simulation of the braco arm (the braco_description model under gz_ros2_control) and the scripts that move it</description>
  <maintainer email="carlosleal2000@gmail.com">Carlos Teixeira</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The robot model, URDF and controllers.yaml -->
  <exec_depend>braco_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- Gazebo (launch/gazebo.launch.py); installed in the pc image only -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <!-- gripper_action_controller, Gazebo only (#123) -->
  <exec_depend>parallel_gripper_controller</exec_depend>
  <!-- scripts/: braco_arm.py drives Gazebo and then, on request, the real arm (arm_driver) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>braco_interfaces</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>xacro</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
